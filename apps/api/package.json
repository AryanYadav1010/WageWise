{
  "name": "@wagewise/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "holidays:refresh": "tsx src/ingest/refresh-bank-holidays.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:migrate": "tsx src/cli/migrate.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "ingest:verify": "tsx src/cli/verify.ts",
    "embed": "tsx src/cli/embed.ts",
    "eval:retrieval": "tsx src/cli/eval-retrieval.ts",
    "eval:check-labels": "tsx src/cli/check-labels.ts",
    "licence:review": "tsx src/cli/licence-review.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@huggingface/transformers": "^3.8.1",
    "fastify": "^5.0.0",
    "html-to-text": "^9.0.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
