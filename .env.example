# Copy to .env (git-ignored). The API and CLIs load it automatically outside production.
# Never paste real values into issues, chats or commits.
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=60
# Reverse proxies in front of the API: 0 locally (X-Forwarded-For ignored), 1 on Render.
TRUST_PROXY_HOPS=0
VITE_API_URL=http://localhost:3001

# --- Database (Neon Postgres with pgvector; no Docker needed) ---
# `neon env pull` writes these for the linked branch in .neon (the DEVELOPMENT branch) to .env.local;
# the app reads .env, so copy them across.
# Never put the production branch here; publishing to production is a deliberate step (docs/DEPLOYMENT.md).
# Pooled connection (host contains "-pooler"): used by the API.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Direct connection: used by db:migrate, ingest, embed (they hold advisory locks).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Optional override for the direct connection.
# DIRECT_DATABASE_URL=
# SEPARATE "test" branch, DIRECT connection (`neon connection-string test`):
# test:db creates and drops its own databases here.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-yyyy.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Retrieval ---
# local-bge-small runs BAAI/bge-small-en-v1.5 in-process (downloads ~133 MB once into .cache/).
EMBEDDING_PROVIDER=local-bge-small
# Minimum cosine similarity for a result to count as relevant, from `npm run eval:retrieval` on the
# approved content (keeps95PercentOfAnswerable). Chat stays off (health: not_configured) without it.
# 0.7089 was calibrated on 29 Oct 2026 for the first five approved guides; recalibrate when they change.
SEARCH_MIN_SIMILARITY=0.7089

# --- Answers (chat) ---
# Server-side only: never prefix with VITE_.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# --- Ingestion tuning (defaults shown) ---
# INGEST_MAX_CHUNK_CHARS=1200
# INGEST_CHUNK_OVERLAP_CHARS=150
# INGEST_REQUEST_DELAY_MS=250
